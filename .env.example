# Copy to .env. Credentials stay on the backend; never paste into chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional OpenAI-compatible LOCAL server, e.g. Ollama. Only loopback is accepted.
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen3:8b
# API modes must be selected explicitly in the UI. Demo spends no tokens.
MONTHLY_BUDGET_USD=15
# Optional gateway for credits/free models. Choose an available tool-capable model.
# No paid fallback; account/platform quotas apply separately.
GATEWAY_URL=https://openrouter.ai/api/v1
GATEWAY_API_KEY=
GATEWAY_MODEL=
# A prebuilt, local sandbox image. Never pulled automatically during a run.
SANDBOX_IMAGE=research-studio-sandbox:local
# Dedicated OpenClaw bridge. scripts/openclaw.py setup generates local gateway token.
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT=research
# Set to openrouter/<your-model>:free after adding GATEWAY_API_KEY.
OPENCLAW_CHEAP_MODEL=openai/gpt-6-luna
# Extra per-call reservation for harness/system-prompt overhead. Not a provider billing guarantee.
OPENCLAW_CALL_RESERVE_USD=0.10
